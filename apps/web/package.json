{
  "name": "@ea/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "prepare": "svelte-kit sync || echo ''",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build/index.js",
    "sync": "svelte-kit sync",
    "compile-paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --output-structure locale-modules --strategy cookie preferredLanguage globalVariable baseLocale",
