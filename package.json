{
  "name": "sveltekit-template",
  "description": "Template for SvelteKit projects",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "prepare": "svelte-kit sync || echo ''",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build/index.js",
    "sync": "svelte-kit sync",
    "compile-paraglide": "pnpm dlx @inlang/paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "knip && SVELTE_ESLINT_PARSER_EXPERIMENTAL_TS_SYS_HOOK=1 eslint --concurrency auto .",
    "lint:fix": "knip --fix && SVELTE_ESLINT_PARSER_EXPERIMENTAL_TS_SYS_HOOK=1 eslint --concurrency auto --fix .",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "ci": "pnpm run compile-paraglide && pnpm run check && pnpm run format && pnpm run lint"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.7",
    "@better-auth/i18n": "^1.7.7",
    "@fontsource-variable/inter": "^5.3.0",
    "@redis/client": "^6.3.0",
    "@tanstack/svelte-query": "^6.3.2",
    "@tanstack/svelte-query-devtools": "^6.3.2",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "1.0.0-rc.4",
    "pg": "^8.23.1",
    "resend": "^6.32.1",
    "superjson": "^2.2.6",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@inlang/paraglide-js": "^2.27.0",
    "@lucide/svelte": "^1.55.0",
    "@prgm/sveltekit-progress-bar": "^3.0.2",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.104.2",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "bits-ui": "^2.19.5",
    "cn": "^0.4.0",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.12.0",
    "eslint-plugin-better-tailwindcss": "^4.9.0",
    "eslint-plugin-erasable-syntax-only": "^0.7.2",
    "eslint-plugin-inline-utilities": "^1.0.1",
    "eslint-plugin-slop": "^0.1.3",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-svelte": "^3.23.1",
    "formsnap": "^2.0.1",
    "knip": "^6.41.0",
    "mode-watcher": "^1.1.0",
    "oxfmt": "^0.72.0",
    "shadcn-svelte": "^1.7.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-sonner": "^1.2.1",
    "sveltekit-superforms": "^3.0.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vaul-svelte": "^1.0.0-next.7",
    "vite": "^8.3.4",
    "vite-plugin-devtools-json": "^1.1.2"
  },
  "packageManager": "pnpm@12.11.2",
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
