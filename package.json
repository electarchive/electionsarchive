{
  "name": "electionsarchive",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @ea/web dev",
    "build": "pnpm --filter @ea/web build",
    "compile-paraglide": "pnpm --filter @ea/web compile-paraglide",
    "check": "pnpm --recursive --workspace-concurrency=1 run check",
    "test": "pnpm --filter @ea/engine test",
    "lint": "knip && SVELTE_ESLINT_PARSER_EXPERIMENTAL_TS_SYS_HOOK=1 eslint --concurrency auto .",
    "lint:fix": "knip --fix && SVELTE_ESLINT_PARSER_EXPERIMENTAL_TS_SYS_HOOK=1 eslint --concurrency auto --fix .",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "ci": "pnpm run compile-paraglide && pnpm run check && pnpm run test && pnpm run format && pnpm run lint"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@tanstack/eslint-plugin-query": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-better-tailwindcss": "catalog:",
    "eslint-plugin-erasable-syntax-only": "catalog:",
    "eslint-plugin-inline-utilities": "catalog:",
    "eslint-plugin-slop": "catalog:",
    "eslint-plugin-sonarjs": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "svelte": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.11.2"
}
