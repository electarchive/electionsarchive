  {
   "key": "landtag_1862",
   "tier": "national",
   "name": "Landtagswahlen nach der Konstitutionellen Verfassung von 1862",
   "name_en": "Landtag elections under the 1862 constitution (indirect, through electors)",
   "category": "legislature",
   "goal": "national",
   "measure": {
    "unit": "contest"
   },
   "note": "Under the constitution of 26 September 1862, which the 1921 constitution replaced, voters in each municipality chose electors (Wahlmänner) who elected 12 of the Landtag's 15 members; the Prince appointed the other three.",
   "source": "verfassung",
   "locator": "https://www.gesetze.li/konso/1921015000 (preamble: \"die Verfassung vom 26. September 1862 ... geändert\")",
   "valid_from": "1862-09-26",
   "valid_to": "1918-01-01",
   "est_votes": 40000,
