{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "svelte": true,
  "printWidth": 80,
  "sortPackageJson": false,
  "objectWrap": "collapse",
  "sortTailwindcss": {
    "stylesheet": "./apps/web/src/app.css",
    "functions": ["tv", "cn"],
    "attributes": ["triggerClass", "contentClass"]
  },
  "ignorePatterns": [
    "node_modules",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    ".svelte-kit",
    "apps/web/src/lib/paraglide",
    "apps/web/project.inlang",
    "packages/db/migrations",
    "packages/db/src/core.ts",
    "apps/landing/og-data.js",
    "apps/landing/public/showcase",
    "apps/landing/public/photos",
    "packages/db/src/core-relations.ts"
  ]
}
